<?xml version="1.0" encoding="utf-8"?>
<!-- Tela de bloqueio mostrada por cima de tudo (janela de overlay). Só sai com o
     PIN do responsável. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaryDark"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_title"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_message"
            android:textColor="@color/white"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="24dp" />

        <EditText
            android:id="@+id/lockPin"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:inputType="numberPassword"
            android:hint="@string/pin_hint"
            android:textColorHint="#88FFFFFF"
            android:textColor="@color/white"
            android:gravity="center"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/lockUnlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/lock_unlock" />

        <TextView
            android:id="@+id/lockError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFCDD2"
            android:paddingTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
