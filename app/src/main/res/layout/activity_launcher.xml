<?xml version="1.0" encoding="utf-8"?>
<!-- Tela inicial da criança: papel de parede do sistema ao fundo (tema
     Theme.ControleInfantil.Launcher), relógio no topo e os apps liberados. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Toque e segure no relógio: área do responsável (pede o PIN). -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:longClickable="true">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="@color/launcherText"
            android:textSize="64sp"
            android:fontFamily="sans-serif-light"
            android:shadowColor="@color/launcherShadow"
            android:shadowRadius="8" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d 'de' MMMM"
            android:format24Hour="EEEE, d 'de' MMMM"
            android:textColor="@color/launcherText"
            android:textSize="16sp"
            android:shadowColor="@color/launcherShadow"
            android:shadowRadius="6" />
    </LinearLayout>

    <!-- Só aparece sem Device Owner, enquanto o app não é a tela inicial padrão. -->
    <LinearLayout
        android:id="@+id/homePrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_launcher_hint"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/home_prompt_text"
            android:textColor="@color/launcherText" />

        <Button
            android:id="@+id/btnSetHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_prompt_button" />
    </LinearLayout>

    <TextView
        android:id="@+id/blockedHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/bg_launcher_hint"
        android:textColor="@color/launcherText"
        android:textSize="20sp"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <!-- Na tela de descanso: atalho para o responsável entrar (pede o PIN). -->
    <Button
        android:id="@+id/btnGuardianBlocked"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/guardian_area_button"
        android:visibility="gone" />

    <TextView
        android:id="@+id/emptyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/bg_launcher_hint"
        android:text="@string/launcher_empty"
        android:textColor="@color/launcherText"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appsGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp" />

</LinearLayout>
