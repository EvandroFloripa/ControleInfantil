<?xml version="1.0" encoding="utf-8"?>
<!-- Zona de risco: fundo branco com borda tracejada rosada, para destacar o isolamento. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <stroke android:width="1dp" android:color="#E8B6BF" android:dashWidth="6dp" android:dashGap="4dp" />
    <corners android:radius="16dp" />
</shape>
