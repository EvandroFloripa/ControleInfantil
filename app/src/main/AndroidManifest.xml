<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Bloqueio de tela por cima de outros apps, sem Device Owner. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Check-in de vídeo/áudio: sempre com notificação visível e a bolinha do
         Android. Nunca oculto. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Ver a tela: o Android exige um toque de consentimento no aparelho. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ControleInfantil">

        <!-- Launcher em modo quiosque: vira a "tela inicial" da criança -->
        <activity
            android:name=".launcher.LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="nosensor"
            android:theme="@style/Theme.ControleInfantil.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela de configuração inicial (responsável) -->
        <activity
            android:name=".setup.SetupActivity"
            android:exported="false" />

        <!-- Escolha dos apps que a criança pode abrir -->
        <activity
            android:name=".launcher.AppPickerActivity"
            android:exported="false" />

        <!-- Limites de horário e tempo diário -->
        <activity
            android:name=".schedule.ScheduleActivity"
            android:exported="false" />

        <!-- Receiver de Device Admin / Device Owner -->
        <receiver
            android:name=".admin.DeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Serviço que consulta a fila de comandos remotos -->
        <service
            android:name=".remote.CommandService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Check-in de vídeo/áudio (notificação visível enquanto ativo) -->
        <service
            android:name=".checkin.CheckinService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Consentimento e compartilhamento de tela -->
        <activity
            android:name=".screen.ScreenCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent" />

        <service
            android:name=".screen.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Re-inicia o serviço após reboot -->
        <receiver
            android:name=".remote.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Bloqueio de apps fora da lista, sem Device Owner (o responsável liga
             a Acessibilidade nas Configurações). -->
        <service
            android:name=".block.AppBlockerService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Resultado da instalação silenciosa (Device Owner). -->
        <receiver
            android:name=".block.InstallResultReceiver"
            android:exported="false" />

    </application>
</manifest>
